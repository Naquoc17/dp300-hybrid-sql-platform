# Copy to .env and fill in. NEVER commit the real .env (gitignored).
# No secrets in source — prefer Entra ID auth (az login) or Key Vault for passwords.

# Azure context
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=westeurope
RESOURCE_GROUP=rg-dp300-capstone

# Logical server + databases
SQL_SERVER_NAME=sql-dp300-cap
SQL_SERVER_FQDN=sql-dp300-cap.database.windows.net
SQL_DB_NAME=sqldb-cap
SQL_SHARD_DBS=sqldb-shard-01,sqldb-shard-02,sqldb-shard-03

# SQL Server on Azure VM (IaaS)
SQL_VM_NAME=vm-dp300-sql

# Auth (prefer Entra ID; SQL auth only where required, password via Key Vault)
SQL_ENTRA_ADMIN=
KEY_VAULT_NAME=
